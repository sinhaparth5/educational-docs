# Serves the built site on :8080 as a non-root user.
# TLS is left to the reverse proxy on the host, so automatic HTTPS is off here.
{
	admin off
	auto_https off
	persist_config off

	# Caddy's own runtime logs, structured
	log {
		output stderr
		format json
	}
}

:8080 {
	root * /srv/www

	# One JSON line per request: method, uri, status, size, duration, user agent…
	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Only our own files plus Google Analytics/GTM (after consent), Giscus and Pagefind's wasm.
		# ponytail: inline scripts/styles stay allowed (theme + consent snippets, KaTeX and Shiki
		# style attributes); move to hashes via Astro's security.csp if user content ever appears.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://*.googletagmanager.com https://giscus.app; style-src 'self' 'unsafe-inline' https://giscus.app; font-src 'self' data:; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://giscus.app https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		-Server
	}

	# Hashed build assets never change, so cache them for a year
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	# Serve the .br / .gz files written at build time instead of compressing per request
	file_server {
		precompressed br gzip
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server {
			precompressed br gzip
		}
	}
}
