---
import Base from '@/layouts/Base.astro';
import ArrowCard from '@/components/posts/arrow-card/ArrowCard.astro';
import { SITE, getPosts } from '@/lib/site';
import styles from '@/styles/pages/home.module.css';

const posts = (await getPosts()).slice(0, SITE.homePosts);
---

<Base>
	<section class={styles.intro}>
		<h1 class={styles.title}>{SITE.title}</h1>
		<p>{SITE.description}</p>
	</section>

	<section>
		<div class={styles.head}>
			<h2 class={styles.heading}>Latest posts</h2>
			<a href="/posts/" class={styles.all}>See all posts</a>
		</div>
		<ul class={styles.cards}>
			{posts.map((post) => <li><ArrowCard post={post} /></li>)}
		</ul>
	</section>
</Base>
