---
import Base from '@/layouts/Base.astro';
import PostItem from '@/components/posts/post-item/PostItem.astro';
import Socials from '@/components/layout/socials/Socials.astro';
import { SITE, getPosts } from '@/lib/site';
import styles from '@/styles/pages/home.module.css';

const posts = await getPosts();
const featured = posts.filter((p) => p.data.featured);
const recent = posts.filter((p) => !p.data.featured).slice(0, SITE.recentPosts);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE.title,
	description: SITE.description,
	url: Astro.site,
	author: { '@type': 'Person', name: SITE.author, url: SITE.socials.website },
};
---

<Base>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<section class={styles.hero}>
		<h1 class={styles.title}>Hi, I'm {SITE.author}.</h1>
		<p class={styles.lead}>
			I write about math and computing. Most posts mix prose and equations with figures you can play
			with: drag a point along a curve, move a slider, edit a formula and watch the graph redraw, or
			turn a 3D surface around to see it from another side.
		</p>
		<p class={styles.lead}>
			Start with the posts below, browse by <a href="/tags/" class={styles.inline}>tag</a>, or <a
				href="/search/"
				class={styles.inline}>search</a
			> for something specific.
		</p>
		<div class={styles.social}>
			<span class={styles.socialLabel}>Elsewhere:</span>
			<Socials />
		</div>
	</section>

	{
		featured.length > 0 && (
			<section class={styles.section}>
				<h2 class={styles.heading}>Featured</h2>
				<ul class={styles.list}>
					{featured.map((post) => (
						<PostItem post={post} heading="h3" showCover />
					))}
				</ul>
			</section>
		)
	}

	{
		recent.length > 0 && (
			<section class={styles.section}>
				<h2 class={styles.heading}>Recent Posts</h2>
				<ul class={styles.list}>
					{recent.map((post) => (
						<PostItem post={post} heading="h3" />
					))}
				</ul>
			</section>
		)
	}

	<div class={styles.more}>
		<a href="/posts/" class={styles.all}>
			All Posts
			<svg class={styles.arrow} viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
		</a>
	</div>
</Base>
