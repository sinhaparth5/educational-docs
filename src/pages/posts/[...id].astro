---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PostDate from '@/components/posts/post-date/PostDate.astro';
import Toc from '@/components/posts/toc/Toc.astro';
import SeriesNav from '@/components/posts/series-nav/SeriesNav.astro';
import Share from '@/components/posts/share/Share.astro';
import Related from '@/components/posts/related/Related.astro';
import CopyCode from '@/components/posts/copy-code/CopyCode.astro';
import Comments from '@/components/posts/comments/Comments.astro';
import Theorem from '@/components/math/theorem/Theorem.astro';
import Proof from '@/components/math/proof/Proof.astro';
import Note from '@/components/math/note/Note.astro';
import Sidenote from '@/components/math/sidenote/Sidenote.astro';
import DocCard from '@/components/posts/doc-card/DocCard.astro';
import { SITE, getPosts, readingTime, relatedPosts, seriesParts } from '@/lib/site';
import styles from '@/styles/pages/post.module.css';
import literataLatin from '@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url';

export async function getStaticPaths() {
	const posts = await getPosts();
	// posts are newest first, so "next" (newer) is i - 1
	return posts.map((post, i) => ({
		params: { id: post.id },
		props: {
			post,
			newer: posts[i - 1],
			older: posts[i + 1],
			related: relatedPosts(post, posts),
			parts: seriesParts(post, posts),
		},
	}));
}

const { post, newer, older, related, parts } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, tags, draft, cover, coverAlt, series } = post.data;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = cover
	? (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
	: `/og/posts/${post.id}.png`;

// Structured data so search engines can show author, dates and image
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url,
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	image: { '@type': 'ImageObject', url: new URL(ogImage, Astro.site).href, width: 1200, height: 630 },
	inLanguage: 'en',
	datePublished: date.toISOString(),
	dateModified: (updated ?? date).toISOString(),
	author: { '@type': 'Person', name: SITE.author, url: SITE.socials.website },
	publisher: { '@type': 'Person', name: SITE.author, url: SITE.socials.website },
	keywords: tags.join(', '),
	...(series && { isPartOf: { '@type': 'CreativeWorkSeries', name: series.name } }),
};
---

<Base
	title={title}
	description={description}
	ogImage={ogImage}
	ogImageAlt={coverAlt || title}
	type="article"
>
	<Fragment slot="head">
		<link rel="preload" href={literataLatin} as="font" type="font/woff2" crossorigin />
		<meta property="article:author" content={SITE.socials.website} />
		<meta property="article:published_time" content={date.toISOString()} />
		{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Fragment>

	<div data-pagefind-body>
		<a href="/posts/" class={styles.back} data-pagefind-ignore>← Back to posts</a>

		<h1 class={styles.title}>
			{title}
			{draft && <span class={styles.draft}>Draft</span>}
		</h1>
		<div class={styles.meta}>
			<PostDate date={date} updated={updated} minutes={readingTime(post)} />
			<span class={styles.tags}>
				{tags.map((tag) => <a href={`/tags/${tag}/`} class={styles.tag}>#{tag}</a>)}
			</span>
		</div>

		<SeriesNav post={post} parts={parts} />
		<Toc headings={headings} />

		<article class="prose">
			<Content components={{ Theorem, Proof, Note, Sidenote, DocCard }} />
		</article>
	</div>
	<CopyCode />

	<Share title={title} />

	<Related posts={related} />
	<Comments />

	{
		(older || newer) && (
			<nav class={styles.pager} aria-label="Previous and next posts">
				{older ? (
					<a href={`/posts/${older.id}/`} class={styles.page}>
						<span class={styles.label}>← Previous</span>
						{older.data.title}
					</a>
				) : (
					<span />
				)}
				{newer && (
					<a href={`/posts/${newer.id}/`} class:list={[styles.page, styles.next]}>
						<span class={styles.label}>Next →</span>
						{newer.data.title}
					</a>
				)}
			</nav>
		)
	}
</Base>
