---
import styles from './Sidenote.module.css';

// Tufte-style margin note. Use inline, mid-sentence:
//   …a classic result<Sidenote>First proved by Euler in 1736.</Sidenote> about graphs.
// Wide screens: sits in the right margin. Narrow screens: tap the number to show it inline.
const id = `sn-${crypto.randomUUID().slice(0, 8)}`;
---

<label for={id} class={styles.number}><span class="sr-only">Show sidenote</span></label><input
	type="checkbox"
	id={id}
	class={styles.toggle}
/><span class={styles.note} role="note"><slot /></span>
