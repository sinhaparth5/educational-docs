---
import { SITE } from '@/lib/site';
import styles from './Footer.module.css';
---

<footer class={styles.footer}>
	<span>&copy; {new Date().getFullYear()} {SITE.title}</span>
	<span class={styles.links}>
		<a href="/archives/" class={styles.link}>Archives</a>
		<a href="/rss.xml" class={styles.link}>RSS</a>
		<a href="/sitemap-index.xml" class={styles.link}>Sitemap</a>
		<a href="/privacy/" class={styles.link}>Privacy</a>
		<button type="button" class={styles.link} data-consent-open>Cookies</button>
	</span>
</footer>
