---
import { SITE } from '@/lib/site';
import styles from './Header.module.css';

const section = Astro.url.pathname.split('/')[1];
const links = [
	{ href: '/posts/', label: 'Posts', key: 'posts' },
	{ href: '/tags/', label: 'Tags', key: 'tags' },
	{ href: '/about/', label: 'About', key: 'about' },
];
---

<header class={styles.header}>
	<div class={styles.bar}>
		<a href="/" class={styles.title}>{SITE.title}</a>
		<nav class={styles.nav}>
			{
				links.map((l) => (
					<a
						href={l.href}
						class:list={[styles.link, { [styles.active]: section === l.key }]}
						aria-current={section === l.key ? 'page' : undefined}
					>
						{l.label}
					</a>
				))
			}
			<a
				href="/search/"
				class:list={[styles.toggle, { [styles.active]: section === 'search' }]}
				aria-label="Search"
				title="Search"
			>
				<svg class={styles.icon} viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m20 20-4-4"></path>
				</svg>
			</a>
			<button id="theme-toggle" class={styles.toggle} aria-label="Toggle dark mode" title="Toggle dark mode">
				<svg class:list={[styles.icon, styles.moon]} viewBox="0 0 24 24" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
				<svg class:list={[styles.icon, styles.sun]} viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	document.getElementById('theme-toggle')!.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>
