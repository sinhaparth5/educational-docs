---
import type { CollectionEntry } from 'astro:content';
import styles from './ArrowCard.module.css';

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
---

<a href={`/posts/${post.id}/`} class={styles.card}>
	<div class={styles.text}>
		<div class={styles.title}>{post.data.title}</div>
		<div class={styles.desc}>{post.data.description}</div>
	</div>
	<svg class={styles.arrow} viewBox="0 0 24 24" aria-hidden="true">
		<line class={styles.shaft} x1="5" y1="12" x2="19" y2="12"></line>
		<polyline class={styles.head} points="12 5 19 12 12 19"></polyline>
	</svg>
</a>
